{
  "id": "meituan",
  "name": "@partme.ai/openclaw-meituan",
  "version": "2026.7.1",
  "description": "美团技术服务合作中心 MTOp OpenAPI capability",
  "main": "dist/index.js",
  "activation": { "onStartup": true },
  "contracts": { "tools": ["meituan_openapi_invoke"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "developerId": { "type": "string", "pattern": "^\\d{1,19}$" },
      "signKey": { "type": "string", "minLength": 1, "maxLength": 512, "sensitive": true },
      "appAuthToken": { "type": "string", "minLength": 1, "maxLength": 2048, "sensitive": true },
      "apiBaseUrl": { "type": "string", "format": "uri", "default": "https://api-open-cater.meituan.com" },
      "version": { "type": "string", "minLength": 1, "maxLength": 16, "default": "2" },
      "operations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "apiPath", "businessId"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
            "description": { "type": "string", "minLength": 1, "maxLength": 256 },
            "apiPath": { "type": "string", "minLength": 2, "maxLength": 256, "pattern": "^/" },
            "businessId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "requiresAuth": { "type": "boolean", "default": true }
          }
        }
      },
      "requestTimeoutMs": { "type": "integer", "minimum": 500, "maximum": 60000, "default": 10000 },
      "maxRequestBytes": { "type": "integer", "minimum": 256, "maximum": 1048576, "default": 65536 },
      "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 5242880, "default": 1048576 },
      "maxRequestsPerMinute": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 60 },
      "ownerOnly": { "type": "boolean", "default": true }
    }
  }
}
