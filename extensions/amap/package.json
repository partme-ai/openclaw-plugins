{
  "name": "@partme.ai/openclaw-amap",
  "version": "2026.7.1",
  "type": "module",
  "description": "高德 Web 服务 API 地点搜索工具 — OpenClaw 2026.9.6",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/partme-ai/openclaw-plugins.git",
    "directory": "extensions/amap"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "amap",
    "高德",
    "poi",
    "location"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "openclaw": "2026.9.6",
    "tsup": "^8.2.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.6",
      "minGatewayVersion": "2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6",
      "pluginSdkVersion": "2026.9.6"
    },
    "install": {
      "npmSpec": "@partme.ai/openclaw-amap",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.6"
    }
  }
}
