{
  "id": "knowledge",
  "name": "Knowledge RAG",
  "version": "2026.7.1",
  "description": "Knowledge RAG engine with bounded retrieval, namespace isolation, and owner-gated file ingestion",
  "main": "dist/index.js",
  "activation": {
    "onStartup": true,
    "onCapabilities": ["tool", "hook"]
  },
  "channels": [],
  "commands": [],
  "skills": [],
  "contracts": { "tools": ["knowledge_add", "knowledge_query", "knowledge_update", "knowledge_delete"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["enabled"],
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "embedding": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "enum": ["openai", "dashscope", "zhipu", "qianfan", "ollama"], "default": "openai" },
          "apiKey": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "model": { "type": "string", "minLength": 1, "maxLength": 256, "default": "text-embedding-ada-002" },
          "dimensions": { "type": "integer", "minimum": 1, "maximum": 65536, "default": 1536 },
          "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
          "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000, "default": 30000 },
          "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5, "default": 2 },
          "maxBatchSize": { "type": "integer", "minimum": 1, "maximum": 2048, "default": 64 },
          "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864, "default": 8388608 }
        }
      },
      "store": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "enum": ["sqlite-vec", "zvec"], "default": "sqlite-vec" },
          "dbPath": { "type": "string", "minLength": 1, "maxLength": 4096, "default": "./data/knowledge.db" }
        }
      },
      "retrieval": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "strategy": { "type": "string", "enum": ["hybrid", "vector", "keyword"], "default": "hybrid" },
          "topK": { "type": "integer", "minimum": 1, "maximum": 100, "default": 5 },
          "minScore": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.3 },
          "vectorWeight": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
          "keywordWeight": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.3 }
        }
      },
      "injection": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "position": { "type": "string", "enum": ["system", "user"], "default": "system" },
          "template": { "type": "string", "minLength": 1, "maxLength": 16384, "default": "以下是相关知识库内容，请据此回答用户问题：\n\n{context}" },
          "maxChunks": { "type": "integer", "minimum": 1, "maximum": 100, "default": 5 },
          "maxTokens": { "type": "integer", "minimum": 1, "maximum": 131072, "default": 2048 }
        }
      },
      "intentGate": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "mode": { "type": "string", "enum": ["rule", "strict"], "default": "rule" },
          "triggers": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
          "skips": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
        }
      },
      "tokenizer": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "enum": ["tiktoken", "zhipu"] },
          "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
          "apiKey": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "model": { "type": "string", "minLength": 1, "maxLength": 256 },
          "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000, "default": 30000 },
          "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5, "default": 2 },
          "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 8388608, "default": 1048576 }
        }
      },
      "reranker": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "enum": ["jina", "zhipu"] },
          "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
          "apiKey": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "model": { "type": "string", "minLength": 1, "maxLength": 256 },
          "topN": { "type": "integer", "minimum": 0, "maximum": 100 },
          "returnDocuments": { "type": "boolean" },
          "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000, "default": 30000 },
          "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5, "default": 2 },
          "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864, "default": 8388608 }
        }
      },
      "parser": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "enum": ["zhipu", "ollama"] },
          "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
          "apiKey": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "model": { "type": "string", "minLength": 1, "maxLength": 256 },
          "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000, "default": 30000 },
          "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5, "default": 2 },
          "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864, "default": 16777216 },
          "maxFileBytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824, "default": 20971520 }
        }
      },
      "tools": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "allowFileIngest": { "type": "boolean", "default": false },
          "allowedFileRoots": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 4096 }, "default": [] },
          "maxFileBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824, "default": 10485760 },
          "maxInputChars": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 100000 },
          "allowOwnerGlobalNamespaces": { "type": "boolean", "default": true }
        }
      }
    }
  },
  "uiHints": {
    "enabled": { "label": "Enable Knowledge RAG", "type": "toggle" },
    "embedding.provider": { "label": "Embedding Provider", "type": "select" },
    "store.provider": { "label": "Vector Store", "type": "select" },
    "retrieval.strategy": { "label": "Retrieval Strategy", "type": "select" },
    "tools.allowFileIngest": { "label": "Allow Owner File Ingest", "type": "toggle" }
  },
  "capabilities": { "knowledgeRAG": true },
  "channelConfigs": {}
}
