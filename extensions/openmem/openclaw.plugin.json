{
  "id": "openmem",
  "version": "2026.7.1",
  "kind": "memory",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "required": { "type": "boolean", "default": false },
      "baseUrl": {
        "type": "string",
        "description": "OpenMem REST base URL",
        "default": "http://127.0.0.1:3317"
      },
      "agentId": { "type": "string", "minLength": 1, "maxLength": 128, "default": "main" },
      "maxSearchResults": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
      "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000, "default": 5000 },
      "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
      "retryBaseDelayMs": { "type": "integer", "minimum": 0, "maximum": 5000, "default": 100 },
      "maxRequestBytes": { "type": "integer", "minimum": 1024, "maximum": 8388608, "default": 2097152 },
      "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216, "default": 2097152 },
      "maxCacheBytes": { "type": "integer", "minimum": 1048576, "maximum": 67108864, "default": 8388608 },
      "allowSharedRecall": { "type": "boolean", "default": false },
      "apiKeyEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "authHeader": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$", "default": "Authorization" },
      "authScheme": { "type": "string", "maxLength": 64, "default": "Bearer" }
    }
  },
  "contracts": {
    "tools": ["openmem_search"]
  }
}
