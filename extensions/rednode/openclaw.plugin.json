{
  "id": "rednode",
  "name": "@partme.ai/openclaw-rednode",
  "version": "2026.7.1",
  "description": "小红书 Ark Open API capability",
  "main": "dist/index.js",
  "activation": { "onStartup": true },
  "contracts": { "tools": ["rednode_ark_invoke"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "appKey": { "type": "string", "minLength": 1, "maxLength": 256 },
      "appSecret": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "sensitive": true
      },
      "environment": {
        "type": "string",
        "enum": ["production", "sandbox"],
        "default": "production"
      },
      "apiBaseUrl": { "type": "string", "format": "uri" },
      "operations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "method", "apiPath"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "method": { "type": "string", "enum": ["GET", "POST", "PUT"] },
            "apiPath": {
              "type": "string",
              "pattern": "^/ark/open_api/",
              "maxLength": 256
            }
          }
        }
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 500,
        "maximum": 60000,
        "default": 30000
      },
      "maxRequestBytes": {
        "type": "integer",
        "minimum": 256,
        "maximum": 1048576,
        "default": 65536
      },
      "maxResponseBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 10485760,
        "default": 2097152
      },
      "maxToolResultBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 1048576,
        "default": 262144
      },
      "maxRequestsPerMinute": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000,
        "default": 60
      },
      "maxConcurrentRequests": {
        "type": "integer",
        "minimum": 1,
        "maximum": 128,
        "default": 8,
        "description": "Maximum concurrent Ark HTTP invocations per Gateway process"
      },
      "getRetryMaxAttempts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "default": 3
      },
      "retryInitialDelayMs": {
        "type": "integer",
        "minimum": 50,
        "maximum": 10000,
        "default": 250
      },
      "retryMaxDelayMs": {
        "type": "integer",
        "minimum": 50,
        "maximum": 60000,
        "default": 2000
      },
      "retryJitterRatio": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.2
      },
      "allowCustomApiBaseUrl": {
        "type": "boolean",
        "default": false,
        "description": "Explicitly allow sending Ark credentials to a trusted custom HTTPS proxy"
      },
      "ownerOnly": { "type": "boolean", "default": true }
    }
  }
}
