{
  "name": "@partme.ai/wechat-ipad",
  "version": "2026.7.1",
  "description": "Opt-in OpenClaw channel for a separately operated, unofficial WeChat iPad protocol bridge",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "keywords": ["openclaw", "plugin", "wechat", "ipad-protocol", "protocol-bridge"],
  "author": "PartMe",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "LICENSE",
    "tsconfig.json",
    "tsup.config.ts",
    "vitest.config.ts"
  ],
  "publishConfig": { "access": "public" },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "openclaw": "2026.7.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "setupEntry": "./dist/setup-entry.js",
    "build": { "openclawVersion": "2026.7.1" },
    "compat": { "pluginApi": ">=2026.7.1", "minGatewayVersion": "2026.7.1" },
    "channel": {
      "id": "wechat-ipad",
      "label": "WeChat iPad external bridge",
      "blurb": "Opt-in external bridge; disabled until the operator explicitly accepts the unofficial-protocol risk."
    }
  },
  "peerDependencies": { "openclaw": ">=2026.7.1" },
  "peerDependenciesMeta": { "openclaw": { "optional": true } },
  "repository": {
    "type": "git",
    "url": "https://github.com/partme-ai/openclaw-plugins.git",
    "directory": "extensions/wechat-ipad"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  }
}
