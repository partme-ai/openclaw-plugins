            "properties": {
              "connectTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000, "default": 10000 },
              "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000, "default": 10000 },
              "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760, "default": 1048576 },
              "maxEventBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760, "default": 1048576 },
              "heartbeatIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000 },
              "pongTimeoutMs": { "type": "integer", "minimum": 500, "maximum": 120000, "default": 10000 }
            }
          },
          "message": {
