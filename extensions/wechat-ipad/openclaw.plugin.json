              "initialDelayMs": { "type": "integer", "minimum": 100, "maximum": 60000, "default": 1000 },
              "maxDelayMs": { "type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000 },
              "maxRetries": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 30 },
              "jitterRatio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.2 }
            }
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "token": { "type": "string", "minLength": 1 } }
          },
          "network": {
