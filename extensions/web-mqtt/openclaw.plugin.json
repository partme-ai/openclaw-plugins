{
  "id": "web-mqtt",
  "name": "web-mqtt",
  "version": "2026.7.1",
  "description": "Enterprise MQTT over WebSocket channel plugin for OpenClaw",
  "channels": ["mqtt-ws"],
  "commands": [],
  "skills": [],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "uiHints": {},
  "capabilities": {
    "protocolBridge": true,
    "websocket": true
  },
  "channelConfigs": {
    "mqtt-ws": {
      "label": "MQTT over WebSocket",
      "description": "Enterprise MQTT over WebSocket channel plugin for OpenClaw",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 15675 },
          "path": { "type": "string", "pattern": "^/[^?#]*$", "default": "/ws" },
          "host": { "type": "string", "minLength": 1, "default": "127.0.0.1" },
          "maxConnections": { "type": "integer", "minimum": 1, "default": 5000 },
          "topicPrefix": { "type": "string", "minLength": 1, "default": "openclaw/" },
          "subscribeTopics": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "topicBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "topicPattern": { "type": "string", "minLength": 1 },
                "agentId": { "type": "string", "minLength": 1 },
                "accountId": { "type": "string" },
                "replyTopic": { "type": "string" }
              },
              "required": ["topicPattern", "agentId"]
            },
            "default": []
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": { "type": "string", "enum": ["jsonTextOrPlain"], "default": "jsonTextOrPlain" },
              "outboundFormat": {
                "type": "string",
                "enum": ["envelope", "legacyJsonText", "plainText"],
                "default": "envelope"
              }
            }
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": { "type": "boolean", "default": true },
              "allowAnonymous": { "type": "boolean", "default": false },
              "users": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "username": { "type": "string", "minLength": 1 },
                    "password": { "type": "string" },
                    "passwordHash": { "type": "string" },
                    "hashAlgorithm": { "type": "string", "enum": ["sha256", "sha512"] },
                    "publishAllow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "subscribeAllow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "aclRules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "action": { "type": "string", "enum": ["publish", "subscribe", "inbound", "outbound"] },
                          "topicPattern": { "type": "string", "minLength": 1 },
                          "effect": { "type": "string", "enum": ["allow", "deny"] },
                          "accountId": { "type": "string" }
                        },
                        "required": ["action", "topicPattern", "effect"]
                      }
                    }
                  },
                  "required": ["username"]
                },
                "default": []
              }
            }
          },
          "tls": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean", "default": false },
              "keyFile": { "type": "string" },
              "certFile": { "type": "string" },
              "caFile": { "type": "string" },
              "minVersion": { "type": "string", "enum": ["TLSv1.2", "TLSv1.3"], "default": "TLSv1.2" },
              "requestCert": { "type": "boolean", "default": false },
              "rejectUnauthorized": { "type": "boolean", "default": false }
            }
          },
          "ws": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "compress": { "type": "boolean", "default": false },
              "idleTimeoutMs": { "type": "integer", "minimum": 1, "default": 60000 },
              "maxFrameSize": { "type": "integer", "minimum": 1024, "default": 262144 },
              "allowedOrigins": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "default": []
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxPayloadBytes": { "type": "integer", "minimum": 1, "default": 262144 },
              "maxSubscriptionsPerClient": { "type": "integer", "minimum": 1, "default": 200 }
            }
          },
          "proxyProtocol": { "type": "boolean", "const": false, "default": false }
        }
      }
    }
  }
}
