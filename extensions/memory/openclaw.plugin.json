{
  "id": "memory",
  "kind": "memory",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "dataDir": { "type": "string", "description": "数据存储目录" },
      "maxSearchResults": { "type": "number", "minimum": 1, "maximum": 100, "default": 10 },
      "retentionDays": { "type": "number", "minimum": 1, "maximum": 3650, "default": 90 },
      "extractionInterval": { "type": "number", "minimum": 1, "maximum": 100, "default": 5 },
      "maxRecordBytes": { "type": "number", "minimum": 1024, "maximum": 1048576, "default": 65536 },
      "profileScope": { "type": "string", "enum": ["session", "agent"], "default": "session" },
      "encryptionKeyEnv": { "type": "string", "description": "可选 AES-256-GCM 密钥环境变量名" }
    }
  },
  "contracts": {
    "tools": ["memory_search"]
  }
}
