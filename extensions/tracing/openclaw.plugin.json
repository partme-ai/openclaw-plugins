{
  "id": "tracing",
  "name": "openclaw-tracing",
  "version": "2026.7.1",
  "description": "Bounded OpenTelemetry-compatible tracing for OpenClaw message and tool lifecycles",
  "main": "dist/index.js",
  "activation": {
    "onStartup": true
  },
  "channels": [],
  "commands": [],
  "skills": [],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable tracing"
      },
      "backend": {
        "type": "string",
        "enum": ["log", "file", "otlp"],
        "default": "log",
        "description": "Trace export backend"
      },
      "otlpEndpoint": {
        "type": "string",
        "default": "http://localhost:4318/v1/traces",
        "description": "OTLP HTTP collector base URL or full /v1/traces URL"
      },
      "otlpHeaders": {
        "type": "object",
        "additionalProperties": { "type": "string", "minLength": 1 },
        "default": {},
        "description": "Optional OTLP HTTP authentication headers; values are never exposed by status routes"
      },
      "sampleRate": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 1,
        "description": "Deterministic sampling rate"
      },
      "traceDir": {
        "type": "string",
        "minLength": 1,
        "default": "./traces",
        "description": "JSONL output directory for the file backend"
      },
      "traceRetentionDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3650,
        "default": 7,
        "description": "Days to retain file backend JSONL traces"
      },
      "maxSpansPerTrace": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000,
        "default": 100,
        "description": "Maximum spans retained for one trace"
      },
      "maxActiveTraces": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000,
        "default": 1000,
        "description": "Maximum concurrently active traces; multiplied by maxSpansPerTrace must not exceed 100000"
      },
      "maxBufferedSpans": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000,
        "default": 10000,
        "description": "Maximum unsent spans retained by buffered backends"
      },
      "flushIntervalMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 3600000,
        "default": 5000,
        "description": "Buffered backend flush interval in milliseconds"
      },
      "exportTimeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 300000,
        "default": 10000,
        "description": "OTLP request timeout in milliseconds"
      },
      "exportRetryAttempts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 3,
        "description": "OTLP attempts per flush"
      },
      "shutdownTimeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 300000,
        "default": 15000,
        "description": "Maximum total wait for trace finalization and backend shutdown"
      },
      "captureMessageBody": {
        "type": "boolean",
        "default": false,
        "description": "Capture up to 500 message characters; privacy-sensitive"
      }
    }
  },
  "uiHints": {
    "enabled": { "label": "Enable Tracing", "type": "switch" },
    "backend": { "label": "Tracing Backend", "type": "select" },
    "otlpEndpoint": { "label": "OTLP Endpoint", "placeholder": "http://localhost:4318/v1/traces" },
    "sampleRate": { "label": "Sample Rate", "type": "slider", "min": 0, "max": 1, "step": 0.01 },
    "captureMessageBody": { "label": "Capture Message Body", "type": "switch" }
  },
  "capabilities": {
    "distributedTracing": true
  },
  "channelConfigs": {}
}
