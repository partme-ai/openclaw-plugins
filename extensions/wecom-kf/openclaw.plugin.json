{
  "id": "wecom-kf",
  "name": "@partme.ai/wecom-kf",
  "description": "企业微信微信客服插件 — KF 消息收发 + Control Tools（wecom_kf_*）；ICS / agents / skills 为可选运营资产",
  "version": "2026.7.1",
  "main": "dist/index.js",
  "channels": [
    "wecom-kf"
  ],
  "skills": [],
  "contracts": {
    "tools": ["wecom_kf_list_servicers", "wecom_kf_list_accounts", "wecom_kf_get_account_link", "wecom_kf_transfer_session"]
  },
  "capabilities": {
    "humanTransfer": true,
    "satisfactionSurvey": true,
    "sessionManagement": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "toolMetadata": {
    "wecom_kf_list_servicers": { "optional": true, "description": "获取接待人员列表（控制面，不进 LLM 上下文）" },
    "wecom_kf_list_accounts": { "optional": true, "description": "获取客服账号列表（控制面，不进 LLM 上下文）" },
    "wecom_kf_get_account_link": { "optional": true, "description": "获取客服账号链接（控制面，不进 LLM 上下文）" },
    "wecom_kf_transfer_session": { "optional": true, "description": "转接客服会话（控制面，不进 LLM 上下文）" }
  },
  "channelConfigs": {
    "wecom-kf": {
      "label": "WeCom KF（企业微信客服）",
      "description": "企业微信微信客服 — KF 回调 + Control Tools；ICS/agents/skills 可选",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "defaultAccount": { "type": "string" },
          "webhookPath": { "type": "string", "pattern": "^/" },
          "apiBaseUrl": { "type": "string", "format": "uri" },
          "corpId": { "type": "string" },
          "corpSecret": { "type": "string" },
          "token": { "type": "string" },
          "encodingAESKey": { "type": "string", "minLength": 43, "maxLength": 43 },
          "openKfId": { "type": "string" },
          "agentId": { "type": "string" },
          "accounts": { "type": "object", "additionalProperties": true },
          "session": { "type": "object", "additionalProperties": true },
          "eventMessages": { "type": "object", "additionalProperties": true },
          "humanTransfer": { "type": "object", "additionalProperties": true },
          "media": { "type": "object", "additionalProperties": true },
          "network": { "type": "object", "additionalProperties": true },
          "routing": { "type": "object", "additionalProperties": true },
          "agentMapping": { "type": "object", "additionalProperties": { "type": "string" } },
          "servicerUserId": { "type": "string" },
          "welcomeText": { "type": "string" }
        }
      }
    }
  }
}
