{
  "name": "@partme.ai/openclaw-message-sdk",
  "version": "2026.7.1",
  "type": "module",
  "description": "统一消息格式 SDK — 所有 openclaw-plugins 渠道插件互通的消息结构定义",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./asr": {
      "types": "./dist/asr/index.d.ts",
      "default": "./dist/asr/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./file": {
      "types": "./dist/file/index.d.ts",
      "default": "./dist/file/index.js"
    },
    "./ocr": {
      "types": "./dist/ocr/index.d.ts",
      "default": "./dist/ocr/index.js"
    },
    "./tts": {
      "types": "./dist/tts/index.d.ts",
      "default": "./dist/tts/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "default": "./dist/bridge/index.js"
    },
    "./dispatch": {
      "types": "./dist/dispatch/index.d.ts",
      "default": "./dist/dispatch/index.js"
    },
    "./ingress": {
      "types": "./dist/ingress/index.d.ts",
      "default": "./dist/ingress/index.js"
    },
    "./dedup": {
      "types": "./dist/dedup/index.d.ts",
      "default": "./dist/dedup/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "default": "./dist/util/index.js"
    },
    "./transcript": {
      "types": "./dist/transcript/index.d.ts",
      "default": "./dist/transcript/index.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "default": "./dist/routing/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./openclaw": {
      "types": "./dist/openclaw/index.d.ts",
      "default": "./dist/openclaw/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./transport/metrics": {
      "types": "./dist/transport/metrics.d.ts",
      "default": "./dist/transport/metrics.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "default": "./dist/lifecycle/index.js"
    }
  },
  "peerDependencies": {
    "@types/node": ">=22",
    "openclaw": ">=2026.7.1",
    "prom-client": "^15.1.3"
  },
  "peerDependenciesMeta": {
    "prom-client": {
      "optional": true
    }
  },
  "files": [
    "dist/",
    "README.md",
    "README.zh-CN.md",
    "docs/ARCHITECTURE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/partme-ai/openclaw-plugins.git",
    "directory": "extensions/message-sdk"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "message",
    "sdk",
    "unified-message"
  ],
  "scripts": {
    "build": "tsup",
    "verify:package": "node scripts/verify-package-exports.mjs",
    "verify:consumers": "node scripts/verify-consumer-contracts.mjs",
    "verify:openclaw": "node scripts/verify-openclaw-contract.mjs",
    "verify:release": "pnpm verify:package && pnpm verify:consumers && pnpm verify:openclaw",
    "benchmark": "pnpm build && node scripts/benchmark-core.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build && pnpm verify:release",
    "prepublishOnly": "pnpm build && pnpm verify:release"
  },
  "dependencies": {
    "undici": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prom-client": "^15.1.3",
    "tsup": "^8.2.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
