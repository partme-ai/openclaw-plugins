{
  "id": "web-stomp",
  "name": "web-stomp",
  "version": "2026.5.25-2",
  "description": "Production STOMP 1.2 over WebSocket/WSS channel for OpenClaw",
  "main": "dist/index.js",
  "channels": ["stomp"],
  "commands": [],
  "skills": [],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "wsPort": { "type": "number", "minimum": 1, "maximum": 65535, "default": 15674 },
      "port": { "type": "number", "minimum": 1, "maximum": 65535, "description": "Deprecated alias for wsPort" },
      "path": { "type": "string", "default": "/ws" },
      "host": { "type": "string", "default": "127.0.0.1" },
      "heartbeat": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "serverMs": { "type": "number", "minimum": 0, "maximum": 300000, "default": 10000 },
          "clientMs": { "type": "number", "minimum": 0, "maximum": 300000, "default": 10000 }
        }
      },
      "defaultAgentId": { "type": "string", "default": "main" },
      "allowedAgentIds": { "type": "array", "items": { "type": "string" }, "default": [] },
      "allowSharedTopics": { "type": "boolean", "default": false },
      "allowedOrigins": { "type": "array", "items": { "type": "string" }, "default": [] },
      "maxConnections": { "type": "number", "minimum": 1, "maximum": 100000, "default": 500 },
      "maxFrameSize": { "type": "number", "minimum": 1, "maximum": 16777216, "default": 262144 },
      "prefetchCount": { "type": "number", "minimum": 1, "maximum": 100000, "description": "Deprecated alias for limits.maxPendingAcks" },
      "limits": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxBufferedBytes": { "type": "number", "minimum": 1, "default": 1048576 },
          "maxSubscriptionsPerConnection": { "type": "number", "minimum": 1, "default": 100 },
          "maxPendingMessages": { "type": "number", "minimum": 1, "default": 32 },
          "maxPendingAcks": { "type": "number", "minimum": 1, "default": 100 },
          "messagesPerMinute": { "type": "number", "minimum": 1, "default": 120 },
          "connectTimeoutMs": { "type": "number", "minimum": 1, "default": 10000 }
        }
      },
      "auth": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "required": { "type": "boolean", "default": true },
          "users": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["login"],
              "properties": {
                "login": { "type": "string" },
                "password": { "type": "string" },
                "passwordEnv": { "type": "string" },
                "passwordHash": { "type": "string" },
                "hashAlgorithm": { "type": "string", "enum": ["sha256", "sha512"], "default": "sha256" }
              }
            }
          }
        }
      },
      "tls": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "keyFile": { "type": "string" },
          "certFile": { "type": "string" },
          "caFile": { "type": "string" },
          "minVersion": { "type": "string", "enum": ["TLSv1.2", "TLSv1.3"], "default": "TLSv1.2" },
          "requestCert": { "type": "boolean", "default": false },
          "rejectUnauthorized": { "type": "boolean", "default": false }
        }
      },
      "ws": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowedOrigins": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      }
    }
  },
  "uiHints": {
    "wsPort": { "label": "WebSocket Port", "placeholder": "15674" },
    "path": { "label": "WebSocket Path", "placeholder": "/ws" },
    "host": { "label": "Bind Host", "placeholder": "127.0.0.1" },
    "defaultAgentId": { "label": "Default Agent ID" },
    "auth.required": { "label": "Require STOMP Authentication", "type": "toggle" },
    "tls.enabled": { "label": "Enable WSS", "type": "toggle" },
    "tls.keyFile": { "label": "TLS Private Key File" },
    "tls.certFile": { "label": "TLS Certificate File" }
  },
  "channelConfigs": {
    "stomp": {
      "label": "STOMP over WebSocket",
      "description": "STOMP 1.2 over WebSocket/WSS for browser and enterprise clients",
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "host": { "type": "string", "default": "127.0.0.1" },
          "wsPort": { "type": "number", "default": 15674 },
          "path": { "type": "string", "default": "/ws" }
        }
      }
    }
  },
  "capabilities": { "protocolBridge": true, "websocket": true, "wss": true }
}
