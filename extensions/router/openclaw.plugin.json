{
  "id": "router",
  "name": "Message Router",
  "version": "2026.7.1",
  "description": "Durable cross-channel routing with retry, DLQ, dedupe, audit, and loop protection.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "rules": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "actions"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "match": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "channels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "direction": { "type": "string", "enum": ["inbound", "outbound", "both"] },
                "topic": { "type": "string", "minLength": 1 },
                "accountId": { "type": "string", "minLength": 1 }
              }
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "target"],
                    "properties": {
                      "type": { "const": "forward" },
                      "target": { "type": "string", "minLength": 1 },
                      "topic": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "target"],
                    "properties": {
                      "type": { "const": "reply-via" },
                      "target": { "type": "string", "minLength": 1 },
                      "accountId": { "type": "string", "minLength": 1 },
                      "to": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "audit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "logToConsole": { "type": "boolean", "default": false },
          "maxEntries": { "type": "integer", "minimum": 100, "maximum": 100000, "default": 5000 }
        }
      },
      "delivery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stateDir": { "type": "string", "minLength": 1 },
          "stateEncryptionKeyEnv": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
            "description": "Environment variable containing the current 32-byte Base64 or 64-character hex AES-256-GCM state key"
          },
          "statePreviousEncryptionKeyEnvs": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" },
            "default": [],
            "description": "Previous state-key environment variables accepted only for online key rotation"
          },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100, "default": 5 },
          "initialDelayMs": { "type": "integer", "minimum": 10, "maximum": 3600000, "default": 500 },
          "maxDelayMs": { "type": "integer", "minimum": 10, "maximum": 86400000, "default": 30000 },
          "backoffMultiplier": { "type": "number", "minimum": 1, "maximum": 10, "default": 2 },
          "jitter": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.2 },
          "dedupeTtlMs": { "type": "integer", "minimum": 1000, "maximum": 2592000000, "default": 86400000 },
          "maxDeliveredKeys": { "type": "integer", "minimum": 100, "maximum": 1000000, "default": 50000 },
          "maxDeadLetters": { "type": "integer", "minimum": 100, "maximum": 1000000, "default": 10000 },
          "maxPendingTasks": { "type": "integer", "minimum": 100, "maximum": 1000000, "default": 10000 },
          "maxPayloadBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216, "default": 1048576 },
          "maxHops": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8 },
          "publishTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000, "default": 15000 },
          "concurrency": { "type": "integer", "minimum": 1, "maximum": 64, "default": 4 },
          "lockHeartbeatMs": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 5000 },
          "lockTimeoutMs": { "type": "integer", "minimum": 5000, "maximum": 300000, "default": 30000 }
        }
      }
    }
  },
  "uiHints": {
    "delivery.stateDir": {
      "label": "Router state directory",
      "placeholder": "router",
      "advanced": true
    }
  }
}
